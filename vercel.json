{
  "version": 2,
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/dist/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/bangkok",
      "destination": "/bangkok/index.html"
    },
    {
      "source": "/bangkok/",
      "destination": "/bangkok/index.html"
    },
    {
      "source": "/pattaya",
      "destination": "/pattaya/index.html"
    },
    {
      "source": "/pattaya/",
      "destination": "/pattaya/index.html"
    },
    {
      "source": "/((?!api/|dist/|css/|images/|bangkok|pattaya|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
